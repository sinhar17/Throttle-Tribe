# Copy to .env and fill in. NEVER commit the real .env.
#
# Generate the two secrets with:
#   openssl rand -base64 48

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=

# Signs every session token. Changing it logs everyone out.
JWT_SECRET=

# --- URLs -----------------------------------------------------------------
# Where the API is reachable (the Cloudflare Tunnel hostname).
API_EXTERNAL_URL=https://api.throttletribe.uk

# The public site. Used for auth redirects and CORS.
SITE_URL=https://throttletribe.uk

# --- Google sign-in -------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials
# -> Create OAuth client ID -> Web application.
# Authorised redirect URI must be exactly:
#   https://api.throttletribe.uk/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Email (magic links) --------------------------------------------------
# Gmail needs an App Password, not the account password:
# Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=throttletribe.uk@gmail.com
SMTP_PASS=

# --- Cloudflare Tunnel ----------------------------------------------------
# Cloudflare Zero Trust -> Networks -> Tunnels -> Create a tunnel
# -> Docker -> copy the token from the install command.
CLOUDFLARE_TUNNEL_TOKEN=
